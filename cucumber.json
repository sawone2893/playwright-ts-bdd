{
  "default": {
    "import": [
      "src/steps/**/*.ts",
      "src/support/**/*.ts"
    ],
    "format": [
      "summary",
      "html:reports/cucumber-report.html",
      "json:reports/cucumber-report.json"
    ],
    "parallel": 4,
    "retry": 2,
    "retryTagFilter": "@flaky or not @smoke"
  },
  "single": {
    "import": [
      "src/steps/**/*.ts",
      "src/support/**/*.ts"
    ],
    "format": [
      "summary"
    ],
    "parallel": 1,
    "retry": 0
  }
}