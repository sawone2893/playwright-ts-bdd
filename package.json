{
  "name": "playwright-ts-bdd",
  "version": "1.0.0",
  "type": "module",
  "description": "Automation Framework created using playwright with typescript and cucumber",
  "main": "index.js",
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); ['reports/screenshots', 'reports/videos', 'reports/traces'].forEach(dir => fs.rmSync(dir, { recursive: true, force: true }));\"",
    "pretest": "npm run clean",
    "test:unit": "tsx --test tests/browser-factory.test.ts tests/scenario-resources.test.ts tests/artifact-naming.test.ts tests/retry-metrics.test.ts",
    "report:retries": "tsx scripts/report-retries.ts",
    "test": "tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:chrome:headed": "cross-env BROWSER=chromium HEADLESS=false tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:firefox:headed": "cross-env BROWSER=firefox HEADLESS=false tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:webkit:headed": "cross-env BROWSER=webkit HEADLESS=false tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:chrome:parallel": "cross-env BROWSER=chromium tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:firefox:parallel": "cross-env BROWSER=firefox tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:webkit:parallel": "cross-env BROWSER=webkit tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:mobile:ios:parallel": "cross-env BROWSER=webkit DEVICE=\"iPhone 15 Pro\" tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:mobile:android:parallel": "cross-env BROWSER=chromium DEVICE=\"Pixel 7\" tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:chrome:negative": "npx cross-env BROWSER=chromium tsx node_modules/@cucumber/cucumber/bin/cucumber.js --tags \"@negative\"",
    "test:chrome:smoke": "npx cross-env BROWSER=chromium tsx node_modules/@cucumber/cucumber/bin/cucumber.js --tags \"@smoke\"",
    "test:chrome:checkout": "npx cross-env BROWSER=chromium tsx node_modules/@cucumber/cucumber/bin/cucumber.js --tags \"@checkout\"",
    "test:chrome:checkout:headed": "npx cross-env BROWSER=chromium HEADLESS=false tsx node_modules/@cucumber/cucumber/bin/cucumber.js --tags \"@checkout\"",
    "test:dev": "cross-env ENV=dev tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:qa": "cross-env ENV=qa tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:staging": "cross-env ENV=staging tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:local": "cross-env ENV=local tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:uifeature": "npx cross-env tsx node_modules/@cucumber/cucumber/bin/cucumber.js features/iframe_demo.feature",
    "test:apifeature": "npx cross-env tsx node_modules/@cucumber/cucumber/bin/cucumber.js features/api/user_api.feature",
    "test-trace": "npx playwright show-trace reports/traces/Complete_end_to_end_checkout_with_multiple_items.zip",
    "report": "node generate-report.cjs",
    "test:report": "npm run test:chrome:parallel && npm run report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sawone2893/playwright-ts-bdd.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/sawone2893/playwright-ts-bdd/issues"
  },
  "homepage": "https://github.com/sawone2893/playwright-ts-bdd#readme",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "multiple-cucumber-html-reporter": "^4.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  }
}
